diff --git a/comm/mindy/test/test_visual_bootstrap.js b/comm/mindy/test/test_visual_bootstrap.js
new file mode 100644
--- /dev/null
+++ b/comm/mindy/test/test_visual_bootstrap.js
@@ -0,0 +1,27 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, you can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const { initializeMindyVisual } = ChromeUtils.importESModule(
+  "resource:///modules/mindy/ui/VisualBootstrap.sys.mjs"
+);
+
+registerCleanupFunction(() => Services.prefs.clearUserPref("mindy.visual.enabled"));
+
+add_task(function test_inherited_default_and_empty_enabled_registry() {
+  Services.prefs.clearUserPref("mindy.visual.enabled");
+  Assert.deepEqual(initializeMindyVisual("about3Pane"), { mode: "inherited" });
+
+  Services.prefs.setBoolPref("mindy.visual.enabled", true);
+  const enabled = initializeMindyVisual("about3Pane");
+  Assert.equal(enabled.mode, "registry-only");
+  Assert.equal(enabled.registry.authority, "contracts/visual/surface-registry.schema.json");
+  Assert.deepEqual(enabled.registry.claims, []);
+});
+
+add_task(function test_unregistered_hook_fails_closed() {
+  Assert.throws(
+    () => initializeMindyVisual("unknown"),
+    /Unregistered Mindy host/
+  );
+});
