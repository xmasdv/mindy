+add_task(async function testAuthorityPackageLoads() {
+  const { VisualPackage } = ChromeUtils.importESModule(
+    "resource:///modules/mindy/ui/VisualPackage.sys.mjs"
+  );
+  Assert.equal(VisualPackage.authority.registry.phase, 0);
+  Assert.equal(VisualPackage.authority.registry.surfaceIds.length, 80);
+  Assert.equal(new Set(VisualPackage.authority.registry.surfaceIds).size, 80);
+});
