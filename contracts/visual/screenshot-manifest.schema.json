{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindy.invalid/contracts/visual/screenshot-manifest.schema.json",
  "title": "Mindy visual evidence manifest",
  "type": "object",
  "required": ["schema_version", "classification", "baseline_status", "source_revisions", "patch_series_sha256", "artifact_sha256", "fixture", "environment", "captured_at", "capture_actor", "review_actor", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "classification": {"enum": ["candidate_runtime_evidence", "accepted_baseline", "rejected_historical_evidence"]},
    "baseline_status": {"enum": ["pending-independent-approval", "accepted", "rejected"]},
    "source_revisions": {"type": "object", "required": ["gecko", "comm"], "properties": {"gecko": {"pattern": "^[a-f0-9]{40}$"}, "comm": {"pattern": "^[a-f0-9]{40}$"}}, "additionalProperties": false},
    "patch_series_sha256": {"type": ["string", "null"]}, "artifact_sha256": {"type": ["string", "null"]},
    "fixture": {"type": "string", "minLength": 1}, "captured_at": {"type": "string", "minLength": 10},
    "environment": {"type": "object", "required": ["os", "scale", "app_zoom", "theme", "locale", "direction"],
      "properties": {"os": {"type": "string", "minLength": 1}, "scale": {"type": "string", "minLength": 1}, "app_zoom": {"type": "string", "minLength": 1}, "theme": {"type": "string", "minLength": 1}, "locale": {"type": "string", "minLength": 1}, "direction": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "capture_actor": {"type": "string", "minLength": 1}, "review_actor": {"type": ["string", "null"]},
    "reason": {"type": "string", "minLength": 1}, "redacted": {"type": "boolean"}, "known_unknowns": {"type": "array"},
    "records": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "path", "sha256", "state", "dimensions"],
      "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "state": {"type": "string", "minLength": 1},
        "dimensions": {"type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$"}, "redaction": {"type": "string"},
        "surface_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}}
  },
  "allOf": [
    {"if": {"properties": {"classification": {"enum": ["candidate_runtime_evidence", "accepted_baseline"]}}}, "then": {"properties": {"patch_series_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    {"if": {"properties": {"classification": {"const": "accepted_baseline"}}}, "then": {"properties": {"baseline_status": {"const": "accepted"}, "review_actor": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"classification": {"const": "rejected_historical_evidence"}}}, "then": {"required": ["reason", "redacted"], "properties": {"baseline_status": {"const": "rejected"}, "review_actor": {"type": "null"}, "redacted": {"const": true}}}}
  ],
  "x-validator": "tools/validate-visual-contracts.py", "x-independent-actors": true, "x-rejected-promotion": false,
  "additionalProperties": false
}
