{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindy.invalid/contracts/visual/surface-registry.schema.json",
  "title": "Mindy visual surface registry",
  "type": "object",
  "required": ["schema_version", "audit_path", "surfaces"],
  "properties": {
    "schema_version": {"const": 1},
    "audit_path": {"const": "docs/VISUAL-AUDIT.md"},
    "surfaces": {
      "type": "array", "minItems": 80, "maxItems": 80,
      "items": {
        "type": "object", "required": ["id", "owner", "boundary", "adapter_contract"],
        "properties": {
          "id": {"type": "string", "pattern": "^(SH|AC|MW|RD|CP|SR|CA|CT|ST|SY|SF|AX)-[0-9]{2}$"},
          "owner": {"enum": ["mindy", "thunderbird", "native", "provider", "shared"]},
          "boundary": {"enum": ["owned", "adapter", "inherited-native", "inherited-external"]},
          "adapter_contract": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-audit-derived": true,
  "x-family-counts": {"SH": 7, "AC": 8, "MW": 10, "RD": 6, "CP": 7, "SR": 4, "CA": 7, "CT": 5, "ST": 9, "SY": 11, "SF": 3, "AX": 3}
}
