diff --git a/comm/mindy/contracts/SurfaceRegistry.sys.mjs b/comm/mindy/contracts/SurfaceRegistry.sys.mjs
new file mode 100644
--- /dev/null
+++ b/comm/mindy/contracts/SurfaceRegistry.sys.mjs
@@ -0,0 +1,16 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, you can obtain one at http://mozilla.org/MPL/2.0/. */
+
+export const SURFACE_REGISTRY_AUTHORITY =
+  "contracts/visual/surface-registry.schema.json";
+
+export function loadSurfaceRegistry(claims = []) {
+  if (!Array.isArray(claims) || claims.length) {
+    throw new Error("Phase 1 cannot claim visual surfaces");
+  }
+  return Object.freeze({
+    authority: SURFACE_REGISTRY_AUTHORITY,
+    claims: Object.freeze([]),
+  });
+}
