diff --git a/comm/mail/mindy/contracts/VisualHost.sys.mjs b/comm/mail/mindy/contracts/VisualHost.sys.mjs
new file mode 100644
--- /dev/null
+++ b/comm/mail/mindy/contracts/VisualHost.sys.mjs
@@ -0,0 +1,49 @@
+import { VisualRegistry } from "resource:///modules/mindy/contracts/VisualRegistry.sys.mjs";
+
+const states = new WeakMap();
+const disabled = Object.freeze({
+  status: "disabled", code: "switch-off", hook: null,
+  inherited: true,
+  registryCount: 0, authoritySha256: null, surfaceClaim: false,
+});
+
+function diagnostic(status, code, hook = null, registry = null) {
+  return Object.freeze({
+    status, code, hook,
+    inherited: status != "active",
+    registryCount: registry?.surfaceIds?.length ?? 0,
+    authoritySha256: registry?.authoritySha256 ?? null,
+    surfaceClaim: false,
+  });
+}
+
+function validRegistry(registry) {
+  const ids = registry?.surfaceIds;
+  return registry === VisualRegistry &&
+    ids.length == 80 && new Set(ids).size == 80 &&
+    registry.authoritySha256 == VisualRegistry.authoritySha256 &&
+    registry.schemaVersion == VisualRegistry.schemaVersion &&
+    registry.phase == VisualRegistry.phase;
+}
+
+export const VisualHost = Object.freeze({
+  initialize(host, hook, registry) {
+    const state = hook == "about3Pane" && validRegistry(registry)
+      ? diagnostic("active", "registry-ready", hook, registry)
+      : diagnostic("rejected", hook == "about3Pane" ? "invalid-registry" : "unknown-hook", hook);
+    states.set(host, state);
+    return state;
+  },
+  reject(host, code) {
+    const state = diagnostic("rejected", code);
+    states.set(host, state);
+    return state;
+  },
+  inspect(host) {
+    return states.get(host) ?? disabled;
+  },
+  cleanup(host) {
+    states.delete(host);
+    return disabled;
+  },
+});
