new file mode 100644
--- /dev/null
+++ b/comm/mail/test/browser/folder-display/browser_mindyVisualHost.js
@@ -0,0 +1,56 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+var { VisualHost } = ChromeUtils.importESModule(
+  "resource:///modules/mindy/contracts/VisualHost.sys.mjs"
+);
+
+async function openHost(enabled) {
+  Services.prefs.setBoolPref("mindy.visual.enabled", enabled);
+  const opened = BrowserTestUtils.domWindowOpenedAndLoaded(
+    null,
+    win => win.document.documentElement.getAttribute("windowtype") == "mail:3pane"
+  );
+  window.openDialog("chrome://messenger/content/messenger.xhtml", "_blank", "chrome,all,dialog=no");
+  const win = await opened;
+  const host = win.document.getElementById("tabmail").currentAbout3Pane;
+  await host.hasDOMContentLoaded.promise;
+  return { host, win };
+}
+
+async function closeHost({ host, win }) {
+  const closed = BrowserTestUtils.windowClosed(win);
+  win.close();
+  await closed;
+  Assert.equal(VisualHost.inspect(host).status, "disabled", "unload cleans host state");
+}
+
+add_task(async function testVisualSwitchHostIsolation() {
+  const off = await openHost(false);
+  Assert.equal(VisualHost.inspect(off.host).status, "disabled", "off inherits startup");
+  for (const id of ["folderPane", "threadPane", "messagePane"]) {
+    Assert.ok(off.host.document.getElementById(id), `${id} inherited startup completes`);
+  }
+  Assert.ok(!off.host.document.querySelector('[data-mindy-shell], link[href*="mindy"], [class*="mindy"]'), "off has no visual claim");
+  await closeHost(off);
+
+  const on = await openHost(true);
+  const state = VisualHost.inspect(on.host);
+  Assert.equal(state.status, "active", "on initializes the registered host");
+  Assert.equal(state.registryCount, 80, "authority registry is complete");
+  Assert.equal(state.authoritySha256, "f43c61ebfc973bcb72cd77bf7b1c14e02e3a7a110a0b6741329d0291ebb4e8ce");
+  Assert.ok(!state.surfaceClaim, "Phase 1B claims no surface");
+  Assert.ok(!on.host.document.querySelector('[data-mindy-shell], link[href*="mindy"], [class*="mindy"]'), "on has no visual claim");
+
+  const unknown = {};
+  const rejected = VisualHost.initialize(unknown, "unknown", state);
+  Assert.equal(rejected.status, "rejected");
+  Assert.equal(rejected.code, "unknown-hook");
+  VisualHost.cleanup(unknown);
+  await closeHost(on);
+});
+
+registerCleanupFunction(() => Services.prefs.clearUserPref("mindy.visual.enabled"));
