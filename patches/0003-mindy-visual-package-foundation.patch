diff --git a/comm/mindy/ui/VisualBootstrap.sys.mjs b/comm/mindy/ui/VisualBootstrap.sys.mjs
new file mode 100644
--- /dev/null
+++ b/comm/mindy/ui/VisualBootstrap.sys.mjs
@@ -0,0 +1,21 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, you can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { loadSurfaceRegistry } from "resource:///modules/mindy/contracts/SurfaceRegistry.sys.mjs";
+import { isMindyVisualEnabled } from "resource:///modules/mindy/adapters/FeatureSwitch.sys.mjs";
+
+const HOOKS = new Set(["about3Pane"]);
+
+export function initializeMindyVisual(hostId) {
+  if (!HOOKS.has(hostId)) {
+    throw new Error(`Unregistered Mindy host: ${hostId}`);
+  }
+  if (!isMindyVisualEnabled()) {
+    return Object.freeze({ mode: "inherited" });
+  }
+  return Object.freeze({
+    mode: "registry-only",
+    registry: loadSurfaceRegistry(),
+  });
+}
