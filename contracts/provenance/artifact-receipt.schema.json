{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mindy artifact provenance receipt",
  "type": "object",
  "required": ["schema_version", "classification", "git", "source_pins", "patches", "build", "configuration", "artifact", "service_policy", "verification", "unknowns", "limitations", "claims", "approval"],
  "properties": {
    "schema_version": {"const": 1},
    "classification": {"enum": ["canonical", "historical", "synthetic", "template"]},
    "git": {"type": "object", "required": ["commit", "integration"]},
    "source_pins": {"type": "object", "required": ["lock_path", "clean_status", "gecko", "comm"]},
    "patches": {"type": "object", "required": ["series_path", "canonical_sha256", "entries"]},
    "build": {"type": "object", "required": ["mozconfig_path", "mozconfig_sha256", "command", "environment"]},
    "configuration": {"type": "object", "required": ["app", "product", "profile", "remoting", "vendor", "channel", "branding", "updater", "lto"]},
    "artifact": {"type": "object", "required": ["path", "sha256", "size", "timestamp", "version", "manifest", "configuration"]},
    "service_policy": {"type": "object", "required": ["issue", "path", "sha256", "endpoints"]},
    "verification": {"type": "array", "minItems": 1, "items": {"required": ["command", "expected", "output"]}},
    "unknowns": {"type": "array", "minItems": 1, "items": {"required": ["status", "code", "detail"]}},
    "limitations": {"type": "array", "minItems": 1, "items": {"required": ["status", "code", "detail"]}},
    "claims": {"type": "array", "minItems": 1},
    "approval": {"type": "object", "required": ["status", "reviewer"]}
  },
  "additionalProperties": false,
  "x-validation": "tools/validate-artifact-receipt.py is the standard-library, fail-closed validator."
}
