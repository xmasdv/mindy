new file mode 100644
index 0000000000..e9f0632443
--- /dev/null
+++ b/comm/mail/test/browser/folder-display/browser_mindyMailShell.js
@@ -0,0 +1,51 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+var { get_about_3pane } = ChromeUtils.importESModule(
+  "resource://testing-common/mail/FolderDisplayHelpers.sys.mjs"
+);
+
+add_task(function test_mindy_shell_is_loaded_without_hiding_upstream_panes() {
+  const about3Pane = get_about_3pane();
+  const { document } = about3Pane;
+  const root = document.documentElement;
+
+  Assert.equal(
+    root.getAttribute("data-mindy-shell"),
+    "true",
+    "The Mindy shell flag should be enabled"
+  );
+  const mindyStyle = document.querySelector(
+    'link[href="chrome://messenger/skin/mindyMail.css"]'
+  );
+  Assert.ok(mindyStyle, "The Mindy shell stylesheet should be linked");
+  Assert.equal(
+    about3Pane.getComputedStyle(root).getPropertyValue("--mindy-accent").trim(),
+    "#6750a4",
+    "The Mindy accent token should be loaded"
+  );
+
+  const panes = [
+    document.getElementById("folderPane"),
+    document.getElementById("threadPane"),
+    document.getElementById("messagePane"),
+  ];
+  for (const pane of panes) {
+    Assert.ok(pane, `${pane.id} should remain present`);
+  }
+  const mindyRules = Array.from(mindyStyle.sheet.cssRules, rule => rule.cssText)
+    .join("\n");
+  Assert.ok(
+    !mindyRules.includes("display: none"),
+    "The Mindy stylesheet should not hide inherited panes"
+  );
+  Assert.stringContains(
+    about3Pane.getComputedStyle(document.getElementById("paneLayout"))
+      .gridTemplateAreas,
+    "folders",
+    "The inherited named grid should remain active"
+  );
+});
